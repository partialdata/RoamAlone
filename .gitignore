# Project-owned plugins elsewhere in Plugins remain eligible for tracking.
/Plugins/Developer/RiderLink/

# Personal editor content and generated cook/package output.
/Content/Developers/
/Build/*/FileOpenOrder/
/Build/Receipts/
/StagedBuilds/
/PackagedBuilds/

# OS metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Keep Source, Config, Content, Build resources, .uproject, and .uplugin files.
